# Minimal CI image - expects pre-built stscale binary in build context
# For local development with delve debugging, use Dockerfile.integration instead

FROM debian:trixie-slim

RUN apt-get --update install --no-install-recommends --yes \
    bash ca-certificates curl dnsutils findutils iproute2 jq less procps python3 sqlite3 \
  && apt-get dist-clean

RUN mkdir -p /var/run/stealthscale /var/lib/stealthscale /etc/stealthscale

# Copy pre-built stscale binary from build context (via `make build` -> stscale)
COPY stscale /usr/local/bin/stscale
RUN ln -sf /usr/local/bin/stscale /usr/local/bin/stealthscale

VOLUME ["/var/lib/stealthscale", "/etc/stealthscale"]
EXPOSE 8080/tcp 9090/tcp 3478/udp 10001-10100/tcp
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 CMD ["/usr/local/bin/stscale", "health"]

ENTRYPOINT []
CMD ["/usr/local/bin/stscale", "serve"]