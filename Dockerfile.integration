# This Dockerfile and the images produced are for testing the coordination
# server, and are in no way endorsed by the original maintainers as an
# official nor supported release or distribution.
#
# This is a modified version of the server that uses Xray/VLESS for
# node-to-node communication to bypass network restrictions.

FROM docker.io/golang:1.26.5-trixie AS builder
ARG VERSION=dev
ENV GOPATH /go
WORKDIR /go/src/stealthscale

# Install delve debugger first - rarely changes, good cache candidate
RUN go install github.com/go-delve/delve/cmd/dlv@latest

# Download dependencies - only invalidated when go.mod/go.sum change
COPY go.mod go.sum /go/src/stealthscale/
RUN go mod download

# Copy source and build - invalidated on any source change
COPY . .

# Build debug binary with debug symbols for delve
RUN CGO_ENABLED=0 GOOS=linux go build -gcflags="all=-N -l" -o /go/bin/stscale ./cmd/stealthscale

# Runtime stage
FROM debian:trixie-slim

RUN apt-get --update install --no-install-recommends --yes \
    bash ca-certificates curl dnsutils findutils iproute2 jq less procps python3 sqlite3 \
  && apt-get dist-clean

RUN mkdir -p /var/run/stealthscale

# Copy binaries from builder
COPY --from=builder /go/bin/stscale /usr/local/bin/stscale