      "description": "StealthScale docs (hy3-free)",
      "mode": "primary",
      "model": "opencode/hy3-free"
    },
    "stealth-builder": {
      "description": "StealthScale builder (muse-spark)",
      "mode": "primary",
      "model": "opencode/muse-spark-1.2-contributor-free"
    }
  }
}