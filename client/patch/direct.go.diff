--- a/control/controlclient/direct.go
+++ b/control/controlclient/direct.go
@@ -30,6 +30,7 @@ import (
     "tailscale.com/tailcfg"
     "tailscale.com/types/key"
     "tailscale.com/util/eventbus"
+    "github.com/tomiwebpro/stealthscale/hscontrol/xray"
 )
 
 // Direct is the classic control client that dials /ts2021 via controlhttp.
@@ -120,7 +121,18 @@ func (c *Direct) tryLogin(ctx context.Context) error {
-    // Original: dial controlhttp to /ts2021
-    conn, err := c.dialControl(ctx)
+    // StealthScale: if VLESS URI is set, dial via VLESS+Reality (xtls/reality+utls)
+    // instead of raw controlhttp. VLESS URI is from --vless-uri flag or TS_VLESS_URI env,
