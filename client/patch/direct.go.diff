+            return fmt.Errorf("parsing TS_VLESS_URI: %w", err)
+        }
+        conn, err = xray.DialVLESS(ctx, cfg)
+        if err != nil {
+            return fmt.Errorf("VLESS dial (reality_xtls): %w", err)
+        }
+    } else {
+        conn, err = c.dialControl(ctx)
+    }
     if err != nil {
         return err
     }
 
     // controlbase handshake is unchanged — now tunneled inside VLESS when VLESS is used
     noiseConn, err := controlbase.Client(ctx, conn, c.machineKey, c.controlKey, uint16(c.capVer))
